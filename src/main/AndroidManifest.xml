<?xml version="1.0" encoding="utf-8"?>
<!--
    VisionPush Android SDK – Library Manifest

    This manifest is merged into the host application manifest at build time.
    It declares the minimum permissions, services, and receivers required for
    FCM push notification delivery and notification-open tracking.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Permissions ────────────────────────────────────────────────────── -->

    <!-- Required for scheduling WorkManager sync tasks -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Required on API 33+ to post notifications (runtime-requested by SDK) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required for vibration on notification display -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Location permissions for optional on-device geofencing (VisionPush.enableGeofencing()).
        The SDK NEVER prompts for these — the HOST APP must request them at runtime at a
        contextually appropriate moment:
          * ACCESS_FINE_LOCATION       — required for any geofence monitoring (Play services
                                         geofencing needs precise location).
          * ACCESS_COARSE_LOCATION     — must be declared TOGETHER with FINE: since Android 12
                                         (API 31) a fine-location request is only valid when
                                         both are declared, and the user may grant approximate
                                         location only. GeofenceManager checks for FINE at
                                         runtime and stays inactive with COARSE alone —
                                         geofences cannot be evaluated at approximate accuracy.
          * ACCESS_BACKGROUND_LOCATION — required on Android 10+ (API 29) to receive geofence
                                         transitions while the app is backgrounded.
        Apps that do not use geofencing can ignore these; declaring them in the library manifest
        does not by itself trigger a runtime prompt or Play review (no prominent disclosure is
        needed until the host actually requests + uses background location).
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!--
        NOTE: SCHEDULE_EXACT_ALARM and RECEIVE_BOOT_COMPLETED are intentionally NOT declared.
        All background work uses WorkManager (no exact alarms), and WorkManager's own merged
        library manifest already declares RECEIVE_BOOT_COMPLETED for its boot-reschedule
        receiver — declaring SCHEDULE_EXACT_ALARM here would needlessly push host apps through
        Google Play's exact-alarm review.
    -->

    <application>

        <!-- ── FCM Messaging Service ─────────────────────────────────────── -->
        <!--
            Handles incoming FCM messages and token refresh events.
            The host app can subclass VisionPushMessagingService if additional
            message processing is required, but this default registration is
            sufficient for standard SDK usage.
        -->
        <service
            android:name="de.visionlab.visionpush.VisionPushMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- ── Notification Open Tracking Receiver ───────────────────────── -->
        <!--
            Receives broadcast intents fired when the user taps a notification
            or an action button. Records the event to the VisionPush API and
            then forwards the deep-link intent to the host application.
        -->
        <receiver
            android:name="de.visionlab.visionpush.NotificationTracker$OpenReceiver"
            android:exported="false" />

        <!-- ── Geofence Transition Receiver ──────────────────────────────── -->
        <!--
            Receives geofence ENTER/EXIT transitions from Google Play services via the
            explicit PendingIntent set up by GeofenceManager, then enqueues a
            GeofenceEventWorker to report the transition. Only active when the host app
            calls VisionPush.enableGeofencing() and has granted location permission.
            exported="false": delivery is via an explicit (in-process) PendingIntent only.
        -->
        <receiver
            android:name="de.visionlab.visionpush.GeofenceTransitionReceiver"
            android:exported="false" />

        <!-- ── WorkManager Initializer (disable auto-init for custom init) ── -->
        <!--
            We use the default WorkManager initializer. Remove this block and
            add a custom WorkManagerInitializer if the host app requires
            on-demand initialization via Configuration.Provider.
        -->

        <!-- ── Default Notification Channel metadata ─────────────────────── -->
        <!--
            These meta-data values provide SDK-level defaults that can be
            overridden at runtime via VisionPush.setDefaultNotificationChannel().
        -->
        <meta-data
            android:name="de.visionlab.visionpush.default_channel_id"
            android:value="visionpush_default" />

        <meta-data
            android:name="de.visionlab.visionpush.default_channel_name"
            android:resource="@string/visionpush_default_channel_name" />

    </application>

</manifest>
